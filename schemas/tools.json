          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "repo": {
          "description": "Restrict the scope to one repository; omit for all known repositories.",
          "type": "string"
        },
        "size": {
          "description": "Measure on-disk size of the rows shown on this page; default false.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
